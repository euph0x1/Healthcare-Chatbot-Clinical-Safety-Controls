# Copy this file to .env and fill in your values.
# cp .env.example .env

# Which provider to use for generation + the hallucination-check validator.
# "gemini" is free (no credit card needed) -- this is the default so the
# project runs at zero cost. "anthropic" is available later if you get
# paid API credits.
LLM_PROVIDER=gemini

# --- Gemini (free) ---
# Get a free key at https://aistudio.google.com/apikey (Google account,
# no credit card, no payment). Check the free-tier rate limits there too --
# they're per-minute/per-day caps, not a token budget.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- Anthropic (paid, optional) ---
# Only needed if you set LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-4-5

# Local persistent vector store directory (created by scripts/build_vector_store.py)
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=medquad

# Minimum top-1 retrieval similarity to treat a health-info answer as
# high-confidence. Tune this against your evaluation set.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35

# How many chunks to retrieve per query
RETRIEVAL_TOP_K=3
